# このファイルを .env.local という名前でコピーして、実際のキーを入れてください。
# .env.local はGit管理外（.gitignoreで除外済み）なので、誤って公開される心配はありません。
# Vercelにデプロイする場合は、Vercelのプロジェクト設定 → Environment Variables に
# 同じ名前・値を登録してください（このファイルはローカル開発専用です）。

# Anthropic Claude（おとりAIの会話に使用）
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Twilio（着信転送先のVoIP番号・通話制御に使用）
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Twilioからの着信Webhookが本物かどうかの検証をスキップしたい場合のみ true
# （ローカル開発でTwilioの署名検証が邪魔なとき以外は false のままにしてください）
TWILIO_SKIP_SIGNATURE_CHECK=false

# Vercel KV（通話ごとの文字起こし・状態を保存するデータベース）
# Vercelダッシュボードで「Storage」→「KV」を作成すると、下記3つの値が自動で
# Environment Variablesに追加されます（ローカルではVercel CLIの `vercel env pull` で取得可能）
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ダッシュボードの簡易パスワード（誰でも通話内容を見られないようにする最低限のロック）
DASHBOARD_PASSWORD=change-me
